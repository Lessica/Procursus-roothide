--- a/lib/Makefile
+++ b/lib/Makefile
@@ -56,6 +56,7 @@
 FLAGS    = $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)
 
 SRCFILES := $(sort $(wildcard *.c))
+NATIVE_STATIC_OBJ := $(patsubst %.c,.native-static/%.o,$(SRCFILES))
 
 include ../Makefile.inc
 
@@ -94,9 +95,13 @@
 
 liblz4.a: $(SRCFILES)
 ifeq ($(BUILD_STATIC),yes)  # can be disabled on command line
+liblz4.a: $(NATIVE_STATIC_OBJ)
 	@echo compiling static library
-	$(COMPILE.c) $^
-	$(AR) rcs $@ *.o
+	$(AR) rcs $@ $(NATIVE_STATIC_OBJ)
+
+.native-static/%.o: %.c
+	@mkdir -p $(@D)
+	$(COMPILE.c) -fno-lto $< -o $@
 endif
 
 ifeq ($(WINBASED),yes)
@@ -134,6 +139,7 @@
 ifeq ($(WINBASED),yes)
 	$(RM) *.rc
 endif
+	$(RM) -r .native-static
 	$(RM) core *.o liblz4.pc dll/$(LIBLZ4).dll dll/$(LIBLZ4_EXP)
 	$(RM) *.a *.$(SHARED_EXT) *.$(SHARED_EXT_MAJOR) *.$(SHARED_EXT_VER)
 	@echo Cleaning library completed
