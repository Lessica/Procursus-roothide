diff --git a/rules/build-package.mk b/rules/build-package.mk
--- a/rules/build-package.mk
+++ b/rules/build-package.mk
@@ -99,6 +99,13 @@ ifneq "$$(NO_INCLUDE_PKGDATA)" "YES"
 $1_$2_PKGDATA_DEP = $1/$2/package-data.mk
 endif
 
+# Stage0 libraries compile against transitive interfaces as well as direct
+# package dependencies. Wait for in-tree boot libraries whose interfaces
+# those packages expose (for example bytestring's Template Haskell instances).
+ifeq "$3" "0"
+$1_$2_HC_DEP += $$(foreach dep,$$($1_$2_TRANSITIVE_DEP_COMPONENT_IDS),$$($$(dep)_dist-boot_v_LIB))
+endif
+
 $(call hs-sources,$1,$2)
 $(call c-sources,$1,$2)
 $(call includes-sources,$1,$2)
diff --git a/rules/build-prog.mk b/rules/build-prog.mk
--- a/rules/build-prog.mk
+++ b/rules/build-prog.mk
@@ -137,6 +137,12 @@ ifneq "$$(NO_INCLUDE_PKGDATA)" "YES"
 endif
 endif
 endif
 
+# Stage0 program objects may import interfaces from transitive boot packages
+# even though only their libraries are prerequisites of the final executable.
+ifeq "$3" "0"
+$1_$2_HC_DEP += $$(foreach dep,$$(if $$($1_$2_PROGRAM_DEP_COMPONENT_IDS),$$($1_$2_PROGRAM_DEP_COMPONENT_IDS),$$($1_$2_TRANSITIVE_DEP_COMPONENT_IDS)),$$($$(dep)_dist-boot_v_LIB))
+endif
+
 $(call all-target,$1,all_$1_$2)
 $(call all-target,$1_$2,$1/$2/build/tmp/$$($1_$2_PROG))
