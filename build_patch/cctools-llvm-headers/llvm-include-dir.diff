--- a/meson.build
+++ b/meson.build
@@ -24,10 +24,17 @@
 
 subdir('EXTERNAL_HEADERS')
 
-llvm_dep = dependency('llvm', modules : ['lto'])
+llvm_include_dir = get_option('llvm-include-dir')
+if llvm_include_dir == ''
+  llvm_dep = dependency('llvm', modules : ['lto'])
+  llvm_compile_dep = llvm_dep.partial_dependency(includes : true, compile_args : true)
+else
+  llvm_compile_dep = declare_dependency(include_directories : include_directories(llvm_include_dir))
+  incdirs += include_directories(llvm_include_dir)
+endif
 blocks_dep = dependency('blocks')
 
-deps = [blocks_dep, llvm_dep.partial_dependency(includes : true, compile_args : true)]
+deps = [blocks_dep, llvm_compile_dep]
 
 libstuff_cflags = []
 if cc.has_header('corecrypto/ccdigest.h')
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -1 +1,2 @@
 option('program-prefix', type : 'string', description : 'Prefix for programs (ex: aarch64-apple-darwin-)')
+option('llvm-include-dir', type : 'string', value : '', description : 'LLVM header include directory for cross builds')
