+static bool cgbi_raw_idat(FILE *fp) {
+ unsigned char header[8], crcbuf[4];
+ uint64_t total = 0, offset = 0;
+ long src = 8, dst = 8;
+ if (fflush(fp)) return false;
+ for (;;) {
+  if (fseek(fp, src, SEEK_SET) || fread(header, 1, 8, fp) != 8) return false;
+  uint32_t len = chunk_length(header);
+  if (!memcmp(header + 4, "IDAT", 4)) total += len;
+  src += 12 + (long)len;
+  if (!memcmp(header + 4, "IEND", 4)) break;
+ }
+ if (total < 6) return false;
+ src = 8;
+ for (;;) {
+  if (fseek(fp, src, SEEK_SET) || fread(header, 1, 8, fp) != 8) return false;
+  uint32_t len = chunk_length(header);
+  bool idat = !memcmp(header + 4, "IDAT", 4);
+  bool end = !memcmp(header + 4, "IEND", 4);
+  if (idat) {
+   uint32_t skip = offset < 2 ? (uint32_t)(2 - offset) : 0;
+   if (skip > len) skip = len;
+   uint64_t limit = total - 4 > offset ? total - 4 - offset : 0;
+   uint32_t stop = limit < len ? (uint32_t)limit : len;
+   uint32_t keep = stop > skip ? stop - skip : 0;
+   chunk_number(header, keep);
+   if (fseek(fp, dst, SEEK_SET) || fwrite(header, 1, 8, fp) != 8) return false;
+   dst += 8;
+   uLong crc = crc32(0, header + 4, 4);
+   if (!copy_range(fp, src + 8 + skip, &dst, keep, &crc)) return false;
+   chunk_number(crcbuf, (uint32_t)crc);
+   if (fseek(fp, dst, SEEK_SET) || fwrite(crcbuf, 1, 4, fp) != 4) return false;
+   dst += 4; offset += len;
+  } else {
+   if (!copy_range(fp, src, &dst, len + 12, NULL)) return false;
+  }
+  src += 12 + (long)len;
+  if (end) break;
+ }
+ return !fflush(fp) && !ftruncate(fileno(fp), dst);
+}
