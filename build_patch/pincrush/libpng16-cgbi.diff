+int copy(char *inf, char *outf) {
+ FILE *in = NULL, *out = NULL;
+ unsigned char buf[8192];
+ size_t size;
+ int result = 1;
+ struct stat ist, ost;
+ bool output_opened = false;
+ in = fopen(inf, "rb");
+ if (!in) goto done;
+ if (!fstat(fileno(in), &ist) && !stat(outf, &ost) &&
+     ist.st_dev == ost.st_dev && ist.st_ino == ost.st_ino) {
+  result = 0;
+  goto done;
+ }
+ out = fopen(outf, "wb");
+ if (!out) goto done;
+ output_opened = true;
+ while ((size = fread(buf, 1, sizeof(buf), in)) != 0)
+  if (fwrite(buf, 1, size, out) != size) goto done;
+ if (ferror(in)) goto done;
+ result = 0;
+done:
+ if (in && fclose(in)) result = 1;
+ if (out && fclose(out)) result = 1;
+ if (result && output_opened) unlink(outf);
+ return result;
 }
 
