+/* CgBI stores raw DEFLATE, while libpng's public writer requires a zlib
+ * stream. Compact only the IDAT stream framing after libpng finishes; pixel
+ * transforms and compression remain with libpng. Memory stays bounded. */
+static uint32_t chunk_length(const unsigned char *p) {
+ return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+        ((uint32_t)p[2] << 8) | p[3];
+}
+
+static void chunk_number(unsigned char *p, uint32_t n) {
+ p[0] = n >> 24; p[1] = n >> 16; p[2] = n >> 8; p[3] = n;
+}
+
+static bool copy_range(FILE *fp, long src, long *dst, uint32_t count, uLong *crc) {
+ unsigned char buf[8192];
+ while (count) {
+  size_t size = count > sizeof(buf) ? sizeof(buf) : count;
+  if (fseek(fp, src, SEEK_SET) || fread(buf, 1, size, fp) != size) return false;
+  if (fseek(fp, *dst, SEEK_SET) || fwrite(buf, 1, size, fp) != size) return false;
+  if (crc) *crc = crc32(*crc, buf, (uInt)size);
+  src += size; *dst += size; count -= size;
+ }
+ return true;
+}
