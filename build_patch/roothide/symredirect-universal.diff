+// Rebinding may append linkedit data. Work on an independent thin file so
+// every offset remains slice-relative, then rebuild the universal container.
+static bool transferBytes(int fd, void* data, size_t size, off_t offset, bool writing)
+{
+    char* bytes = static_cast<char*>(data);
+    while (size) {
+        ssize_t count = writing ? pwrite(fd, bytes, size, offset)
+                                : pread(fd, bytes, size, offset);
+        if (count < 0 && errno == EINTR) continue;
+        if (count <= 0) return false;
+        bytes += count;
+        size -= count;
+        offset += count;
+    }
+    return true;
+}
+
+static int processSlice(std::vector<unsigned char>& bytes,
+                        int (*process)(int,uint64_t,size_t,void*))
+{
+    if (bytes.size() < sizeof(uint32_t)) return -1;
+    uint32_t magic;
+    memcpy(&magic, bytes.data(), sizeof(magic));
+    size_t headerSize = magic == MH_MAGIC_64 ? sizeof(mach_header_64) : sizeof(mach_header);
+    if ((magic != MH_MAGIC && magic != MH_MAGIC_64) || bytes.size() < headerSize) return -1;
+    const mach_header* header = reinterpret_cast<const mach_header*>(bytes.data());
+    if (header->sizeofcmds > bytes.size() - headerSize) return -1;
+    size_t cursor = headerSize;
+    for (uint32_t i = 0; i < header->ncmds; ++i) {
+        if (headerSize + header->sizeofcmds - cursor < sizeof(load_command)) return -1;
+        const load_command* command = reinterpret_cast<const load_command*>(bytes.data() + cursor);
+        if (command->cmdsize < sizeof(load_command) ||
+            command->cmdsize > headerSize + header->sizeofcmds - cursor) return -1;
+        cursor += command->cmdsize;
+    }
+    if (cursor != headerSize + header->sizeofcmds) return -1;
+    FILE* scratch = tmpfile();
+    if (!scratch) return -1;
+    int fd = fileno(scratch);
+    int result = -1;
+    struct stat st;
+    if (transferBytes(fd, bytes.data(), bytes.size(), 0, true) &&
+        process(fd, 0, bytes.size(), bytes.data()) == 0 &&
+        transferBytes(fd, bytes.data(), bytes.size(), 0, true) &&
+        fstat(fd, &st) == 0 && st.st_size >= 0 &&
+        static_cast<uint64_t>(st.st_size) <= bytes.max_size()) {
+        // Include appended bind/signature data, not just the original mapping.
+        bytes.resize(st.st_size);
+        if (transferBytes(fd, bytes.data(), bytes.size(), 0, false)) result = 0;
+    }
+    fclose(scratch);
+    return result;
+}
