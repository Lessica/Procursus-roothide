+#define TSOCKS_DARWIN_INTERPOSE(replacement, original) \
+    __attribute__((used)) static struct { \
+        const void *replacement; \
+        const void *replacee; \
+    } tsocks_interpose_##original \
+    __attribute__((section("__DATA,__interpose,interposing"))) = { \
+        (const void *)(unsigned long)&replacement, \
+        (const void *)(unsigned long)&original \
+    }
+#define TSOCKS_DARWIN_HOOK(name, upper) \
+    extern LIBC_##upper##_RET_TYPE TSOCKS_WRAPPER(name)(LIBC_##upper##_SIG); \
+    TSOCKS_DARWIN_INTERPOSE(TSOCKS_WRAPPER(name), name)
