+#if defined(__APPLE__) && defined(__MACH__)
+/* Darwin libc uses syscall(SYS_sysctl, ...) for queries such as uname. */
+static LIBC_SYSCALL_RET_TYPE handle_sysctl(va_list args)
+{
+	int *name = va_arg(args, int *);
+	unsigned int namelen = va_arg(args, unsigned int);
+	void *oldp = va_arg(args, void *);
+	size_t *oldlenp = va_arg(args, size_t *);
+	void *newp = va_arg(args, void *);
+	size_t newlen = va_arg(args, size_t);
+
+	return tsocks_libc_syscall(SYS_sysctl, name, namelen, oldp,
+			oldlenp, newp, newlen);
+}
+#endif
