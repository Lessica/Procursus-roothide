--- /dev/null
+++ b/src/internal/syscall/unix/executable_darwin.go
@@ -0,0 +1,33 @@
+package unix
+
+import (
+	"internal/abi"
+	"syscall"
+	"unsafe"
+)
+
+//go:cgo_import_dynamic libc_NSGetExecutablePath _NSGetExecutablePath "/usr/lib/libSystem.B.dylib"
+func libc_NSGetExecutablePath_trampoline()
+
+// ExecutablePath queries dyld when the process startup vector has no path.
+func ExecutablePath() (string, error) {
+	var size uint32
+	syscall_syscall(abi.FuncPCABI0(libc_NSGetExecutablePath_trampoline), 0, uintptr(unsafe.Pointer(&size)), 0)
+	if size == 0 {
+		return "", syscall.EINVAL
+	}
+	buf := make([]byte, size)
+	r, _, _ := syscall_syscall(abi.FuncPCABI0(libc_NSGetExecutablePath_trampoline), uintptr(unsafe.Pointer(&buf[0])), uintptr(unsafe.Pointer(&size)), 0)
+	if r != 0 {
+		return "", syscall.EINVAL
+	}
+	for i, c := range buf {
+		if c == 0 {
+			if i == 0 {
+				return "", syscall.EINVAL
+			}
+			return string(buf[:i]), nil
+		}
+	}
+	return "", syscall.EINVAL
+}
