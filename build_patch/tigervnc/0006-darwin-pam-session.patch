--- /dev/null
+++ b/unix/vncserver/tigervnc-darwin.pam
@@ -0,0 +1,4 @@
+# vncsession opens/closes a session only; VNC authentication remains in the server.
+# Match the existing Procursus OpenPAM sshd session policy on Darwin.
+# This file deliberately defines no auth, account or password policy.
+session required pam_permit.so
