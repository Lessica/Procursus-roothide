@@ -75,0 +76,31 @@
+
+int
+zopen_stdio_fd(const char *fname, const char *mode)
+{
+	if (mode[0] == 'r' && mode[1] == '\0' &&
+	    (!strcmp(fname, "/dev/stdin") || !strcmp(fname, "/dev/fd/0")))
+		return (STDIN_FILENO);
+	if (mode[0] == 'w' && mode[1] == '\0' &&
+	    (!strcmp(fname, "/dev/stdout") || !strcmp(fname, "/dev/fd/1")))
+		return (STDOUT_FILENO);
+	return (-1);
+}
+
+FILE *
+zopen_file(const char *fname, const char *mode)
+{
+	int fd, stdio_fd, saved_errno;
+	FILE *stream;
+
+	stdio_fd = zopen_stdio_fd(fname, mode);
+	if (stdio_fd == -1)
+		return (fopen(fname, mode));
+	if ((fd = dup(stdio_fd)) == -1)
+		return (NULL);
+	if ((stream = fdopen(fd, mode)) == NULL) {
+		saved_errno = errno;
+		(void)close(fd);
+		errno = saved_errno;
+	}
+	return (stream);
+}
