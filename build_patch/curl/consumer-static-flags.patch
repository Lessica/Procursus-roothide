--- a/curl-config.in
+++ b/curl-config.in
@@ -174,7 +174,12 @@
 
     --static-libs)
         if test "X@ENABLE_STATIC@" != "Xno" ; then
-          echo "@libdir@/libcurl.@libext@" @LDFLAGS@ @LIBCURL_LIBS@
+          # Consumers supply their own compiler, SDK and search paths.
+          case " @LDFLAGS@ " in
+            *" -liosexec "*) iosexec_lib=-liosexec ;;
+            *) iosexec_lib= ;;
+          esac
+          echo "@libdir@/libcurl.@libext@" @LIBCURL_LIBS@ $iosexec_lib
         else
           echo "curl was built with static libraries disabled" >&2
           exit 1
