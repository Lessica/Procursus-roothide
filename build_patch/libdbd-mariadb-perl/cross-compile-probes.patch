+
+# Target executables cannot run on the build host. Require explicit answers
+# only for the two behavioral probes; API availability still links real code.
+if ($opt->{'cross-compile'}) {
+  die "--dbi-instarch-dir must contain the target DBI headers\n"
+    unless defined $opt->{'dbi-instarch-dir'}
+      && -f File::Spec->catfile($opt->{'dbi-instarch-dir'}, 'Driver.xst')
