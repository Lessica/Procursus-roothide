+      && -f File::Spec->catfile($opt->{'dbi-instarch-dir'}, 'DBIXS.h');
+  for my $key (qw(cross-embedded cross-openssl-deinit)) {
+    die "--$key must be 0 or 1 when cross compiling\n"
+      unless defined $opt->{$key} && $opt->{$key} =~ /^[01]$/;
+  }
+}
