Probe the same UUID header as _uuidmodule.c and prefer libc UUID support.
Avoid confusing OSSP uuid.h with the Darwin/BSD UUID API.

--- a/configure.ac
+++ b/configure.ac
@@ -2877,13 +2877,20 @@
 
 # check for libuuid from util-linux
 save_LIBS=$LIBS
-AC_CHECK_LIB([uuid], [uuid_generate_time])
+AC_CHECK_FUNC([uuid_generate_time], [],
+  [AC_CHECK_LIB([uuid], [uuid_generate_time])])
 LIBS=$save_LIBS
 
 # AIX provides support for RFC4122 (uuid) in libc.a starting with AIX 6.1 (anno 2007)
 # FreeBSD and OpenBSD provides support in libc as well.
 AC_MSG_CHECKING(for uuid_create)
-AC_COMPILE_IFELSE([AC_LANG_PROGRAM([[#include <uuid.h>]], [[
+AC_COMPILE_IFELSE([AC_LANG_PROGRAM([[
+#ifdef HAVE_UUID_UUID_H
+#include <uuid/uuid.h>
+#else
+#include <uuid.h>
+#endif
+]], [[
 #ifndef uuid_create
 void *x = uuid_create
 #endif
@@ -2896,7 +2903,13 @@
 # Little-endian FreeBSD, OpenBSD and NetBSD needs encoding into an octet
 # stream in big-endian byte-order
 AC_MSG_CHECKING(for uuid_enc_be)
-AC_COMPILE_IFELSE([AC_LANG_PROGRAM([[#include <uuid.h>]], [[
+AC_COMPILE_IFELSE([AC_LANG_PROGRAM([[
+#ifdef HAVE_UUID_UUID_H
+#include <uuid/uuid.h>
+#else
+#include <uuid.h>
+#endif
+]], [[
 #ifndef uuid_enc_be
 void *x = uuid_enc_be
 #endif
