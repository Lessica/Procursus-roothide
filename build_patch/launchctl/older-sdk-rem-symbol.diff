+/* The iOS 18 entry point is not in older SDK export stubs. Resolve it
+ * only when the existing availability guard permits the REM operation. */
+static int
+reboot_with_purpose(int purpose)
+{
+ int (*reboot_fn)(int) = (int (*)(int))dlsym(RTLD_DEFAULT,
+     "launch_userspace_reboot_with_purpose");
+ return reboot_fn ? reboot_fn(purpose) : ENOTSUP;
+}
