+/* Follow upstream discovery-session enumeration on tvOS, where the legacy
+ * devicesWithMediaType: selector is absent. Keep other platforms unchanged. */
+static NSArray *get_devices_with_media_type(AVMediaType media_type)
+{
+#if TARGET_OS_TV
+    if ([AVCaptureDeviceDiscoverySession respondsToSelector:
+            @selector(discoverySessionWithDeviceTypes:mediaType:position:)]) {
+        NSMutableArray *types = [NSMutableArray array];
+        if (media_type == AVMediaTypeVideo) {
+            if (&AVCaptureDeviceTypeContinuityCamera != NULL)
+                [types addObject:AVCaptureDeviceTypeContinuityCamera];
+            if (&AVCaptureDeviceTypeExternal != NULL)
+                [types addObject:AVCaptureDeviceTypeExternal];
+        } else if (media_type == AVMediaTypeAudio) {
+            if (&AVCaptureDeviceTypeMicrophone != NULL)
+                [types addObject:AVCaptureDeviceTypeMicrophone];
+        } else if (media_type == AVMediaTypeMuxed) {
+            if (&AVCaptureDeviceTypeExternal != NULL)
+                [types addObject:AVCaptureDeviceTypeExternal];
+        }
+        if ([types count]) {
+            AVCaptureDeviceDiscoverySession *session =
+                [AVCaptureDeviceDiscoverySession
+                    discoverySessionWithDeviceTypes:types
+                                          mediaType:media_type
+                                           position:AVCaptureDevicePositionUnspecified];
+            return [session devices];
+        }
+    }
+    if (![AVCaptureDevice respondsToSelector:@selector(devicesWithMediaType:)]) {
+        av_log(NULL, AV_LOG_WARNING, "AVFoundation device discovery is unavailable for this media type\n");
+        return nil;
+    }
+#endif
+    return [AVCaptureDevice devicesWithMediaType:media_type];
+}
